{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": ["eslint.config.js", "packages/config/tsconfig.base.json", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "NODE_EXTRA_CA_CERTS",
    "NEXT_TELEMETRY_DISABLED",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE",
    "ZITADEL_PAT",
    "BASE_URL"
  ]
}
