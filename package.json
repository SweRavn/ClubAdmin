{
  "name": "clubadmin",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source management system for sports clubs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm run lint:root && pnpm run format:check",
    "lint:root": "eslint --no-warn-ignored eslint.config.js",
    "lint:fix": "turbo run lint -- --fix && eslint --fix --no-warn-ignored eslint.config.js && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "licenses:check": "node packages/config/scripts/check-licenses.ts",
    "commits:check": "node packages/config/scripts/check-commits.ts"
  },
  "devDependencies": {
    "@clubadmin/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
