{
  "name": "clubadmin",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source management system for sports clubs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node packages/devtools/src/cli.ts dev",
    "dev:services": "node packages/devtools/src/cli.ts services",
    "dev:down": "node packages/devtools/src/cli.ts down",
    "dev:logs": "node packages/devtools/src/cli.ts logs",
    "dev:clean": "node packages/devtools/src/cli.ts clean",
    "dev:doctor": "node packages/devtools/src/cli.ts doctor",
    "dev:trust-ca": "node packages/devtools/src/cli.ts trust-ca",
    "dev:smoke": "node packages/devtools/src/cli.ts smoke",
    "auth:configure": "node packages/devtools/src/cli.ts auth-configure",
    "lint": "turbo run lint && pnpm run lint:root && pnpm run lint:deps && pnpm run format:check",
    "lint:root": "eslint --no-warn-ignored eslint.config.js dependency-cruiser.config.mjs",
    "lint:fix": "turbo run lint -- --fix && eslint --fix --no-warn-ignored eslint.config.js && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "licenses:check": "node packages/config/scripts/check-licenses.ts",
    "commits:check": "node packages/config/scripts/check-commits.ts",
    "db:bootstrap": "node packages/db/src/cli.ts bootstrap",
    "db:migrate": "node packages/db/src/cli.ts migrate",
    "db:status": "node packages/db/src/cli.ts status",
    "db:generate": "pnpm --filter @clubadmin/db run generate",
    "lint:deps": "depcruise apps packages --config dependency-cruiser.config.mjs",
    "api:openapi": "pnpm --filter @clubadmin/api run openapi",
    "api:client": "pnpm run api:openapi && pnpm --filter @clubadmin/api-client run generate"
  },
  "devDependencies": {
    "@clubadmin/config": "workspace:*",
    "@clubadmin/devtools": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
