# Always check out with LF line endings, also with Git for Windows.
# Shell scripts, the Caddyfile and other files mounted into Linux containers
# break with CRLF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Sample import files keep their bytes (Windows-1252, CRLF), like real exports.
docs/demodata/imports/*.csv -text
