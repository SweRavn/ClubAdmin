# Development reverse proxy with real HTTPS from Caddy's local CA.
# Trust the CA once with `pnpm dev:trust-ca`.
{
	local_certs
	skip_install_trust
	admin 127.0.0.1:2019
}

{$APP_DOMAIN} {
	encode zstd gzip

	# The web app (Next.js) is also the backend-for-frontend: browser calls to
	# /api/* go through it, which adds the access token from the session.
	handle {
		reverse_proxy {$WEB_UPSTREAM}
	}

	# While the apps are not running (or not built yet), show a placeholder page.
	handle_errors 502 503 504 {
		root * /srv/placeholder
		rewrite * /index.html
		file_server
	}
}

# The API directly, for clients that hold their own tokens (mobile app, integrations).
api.{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy {$API_UPSTREAM}
}

{$AUTH_DOMAIN} {
	encode zstd gzip
	reverse_proxy h2c://zitadel:8080
}

mail.{$APP_DOMAIN} {
	reverse_proxy mailpit:8025
}
