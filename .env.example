# ClubAdmin environment variables.
#
# For local development you do not need to copy this file: `pnpm dev` generates
# .env.local (git-ignored) with random secrets on first run. Apps and scripts
# read .env first, then .env.local (later values win).
#
# This file documents every variable. All values here are dummies.
# Never commit real secrets. See docs/hosting-and-billing.md and docs/development.md.

# --- Application flags ----------------------------------------------------
# development | test | production
NODE_ENV=development
# self_hosted | hosted (hosted enables public club sign-up and the operator console)
DEPLOYMENT_MODE=self_hosted
# true enables plans, subscriptions and invoices (hosted service only)
BILLING_ENABLED=false
# open | invite_only: who can create an account
USER_SIGNUP=open
# open | approval | operators_only: who can create a club (default: open if hosted, else operators_only)
CLUB_CREATION=operators_only
# Country pack for new clubs (SE, NO, ...)
DEFAULT_COUNTRY=SE
# Development-only persona login without Zitadel. The apps refuse to start with
# this enabled unless NODE_ENV=development (see docs/seed-data.md).
DEV_AUTH=false
# Signs DEV_AUTH tokens (web app and API); development only, at least 32 characters
DEV_AUTH_KEY=change-me-change-me-change-me-change-me

# --- Public URLs (Caddy) --------------------------------------------------
APP_DOMAIN=clubadmin.localhost
AUTH_DOMAIN=auth.clubadmin.localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
PUBLIC_WEB_URL=https://clubadmin.localhost
AUTH_ISSUER=https://auth.clubadmin.localhost
WEB_PORT=3000
API_PORT=4000
# Lets Node.js trust Caddy's local CA (written by pnpm dev:trust-ca)
NODE_EXTRA_CA_CERTS=/path/to/ClubAdmin/.local/caddy-root.crt

# --- API and worker -------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Address the API listens on. Caddy runs in Docker and reaches the API on the
# host through the Docker gateway, so use 0.0.0.0 in development.
API_HOST=0.0.0.0
# Browser origins allowed to call the API (comma-separated; default PUBLIC_WEB_URL)
CORS_ORIGINS=https://clubadmin.localhost
# Which proxies may set X-Forwarded-For (Fastify trustProxy)
TRUST_PROXY=loopback,uniquelocal
# Source of the running version (AGPL-3.0 section 13); the commit is appended
SOURCE_URL=https://github.com/SweRavn/ClubAdmin
APP_VERSION=0.0.0
GIT_COMMIT=unknown
# Serve /api/v1/openapi.json (default: on in development)
OPENAPI_ENABLED=true
# Mobile app versions the API supports (GET /api/v1/meta/client, ADR 0029);
# per platform with _IOS / _ANDROID; store pages once published
MOBILE_MIN_VERSION=0.0.0
MOBILE_RECOMMENDED_VERSION=0.0.0
MOBILE_STORE_URL_IOS=
MOBILE_STORE_URL_ANDROID=
# Feature flags for the apps: "name,other=false" (a bare name is on)
FEATURE_FLAGS=
# Mobile app build (apps/mobile/app.config.ts): variant, API URL and the
# over-the-air update server (empty: updates off)
APP_VARIANT=development
MOBILE_API_URL=https://api.clubadmin.localhost
EXPO_UPDATES_URL=
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
# Rate limits per window (docs/security.md, "Rate limits"): requests without a
# valid login per client IP; with a login per account, plus a per-IP backstop
# for shared addresses; bulk reads (rosters) per club and per account
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_ACCOUNT_MAX=600
RATE_LIMIT_IP_BACKSTOP=6000
RATE_LIMIT_CLUB_BULK_MAX=1200
RATE_LIMIT_ACCOUNT_BULK_MAX=240
# First logins (account creation) per client IP and minute
RATE_LIMIT_PROVISIONING_MAX=10
WORKER_CONCURRENCY=5
# Record history retention and partitions created ahead (ADR 0017)
HISTORY_RETENTION_MONTHS=24
HISTORY_PARTITIONS_AHEAD=3
# OpenTelemetry collector (OTLP/HTTP); leave empty to disable telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clubadmin
POSTGRES_PORT=5432
# Superuser, only for `pnpm db:bootstrap` (creates roles and grants)
DATABASE_ADMIN_URL=postgresql://postgres:change-me@127.0.0.1:5432/clubadmin
# Passwords of the database roles (docs/security.md); `pnpm db:bootstrap` sets them.
DB_OWNER_PASSWORD=change-me
DB_APP_PASSWORD=change-me
DB_OPERATOR_PASSWORD=change-me
DB_RETENTION_PASSWORD=change-me
# API and worker: unprivileged role, subject to row-level security
DATABASE_URL=postgresql://clubadmin_app:change-me@127.0.0.1:5432/clubadmin
# Migrations (`pnpm db:migrate`)
DATABASE_OWNER_URL=postgresql://clubadmin_owner:change-me@127.0.0.1:5432/clubadmin
# Retention and erasure jobs (worker)
DATABASE_RETENTION_URL=postgresql://clubadmin_retention:change-me@127.0.0.1:5432/clubadmin
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=change-me

# --- Field encryption -----------------------------------------------------
# Master keys (`id:base64key`, 32 bytes, comma-separated, current first) that
# wrap the data keys of encrypted fields; never stored in the database.
# Required in production. Generate a key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEYS=example:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Key for blind indexes (matching encrypted values), 32 bytes, base64
BLIND_INDEX_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Web app (backend-for-frontend) --------------------------------------
# The API as the web server reaches it
API_INTERNAL_URL=http://127.0.0.1:4000
# Encrypts the tokens in session records (Valkey); 32 bytes, base64
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Identity provider (written by pnpm auth:configure) --------------------
# Zitadel project ID: the audience the API requires in access tokens
AUTH_AUDIENCE=000000000000000000
AUTH_PROJECT_ID=000000000000000000
AUTH_WEB_CLIENT_ID=000000000000000000
AUTH_WEB_CLIENT_SECRET=change-me
AUTH_MOBILE_CLIENT_ID=000000000000000000
# Token of the clubadmin-api machine user (ends Zitadel sessions when a session is revoked)
ZITADEL_API_TOKEN=change-me

# --- Valkey ---------------------------------------------------------------
VALKEY_PORT=6379
# API (rate limits, sessions, authorization caches) and worker (invalidates those caches)
VALKEY_URL=redis://127.0.0.1:6379

# --- Zitadel (identity provider) ------------------------------------------
# Exactly 32 characters
ZITADEL_MASTERKEY=change-me-change-me-change-me-32
ZITADEL_ADMIN_EMAIL=admin@clubadmin.test
ZITADEL_ADMIN_PASSWORD=Change-me-1!
ZITADEL_LOGIN_COOKIE_SECRET=change-me-at-least-32-characters-long

# --- Object storage (S3 API; Garage in development) -----------------------
S3_PORT=3900
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET_FILES=clubadmin-files
S3_BUCKET_BACKUPS=clubadmin-backups
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me
GARAGE_RPC_SECRET=change-me-64-hex-characters
GARAGE_ADMIN_TOKEN=change-me
GARAGE_ADMIN_PORT=3903

# --- Email ----------------------------------------------------------------
SMTP_PORT=1025
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=noreply@clubadmin.test
MAILPIT_UI_PORT=8025
