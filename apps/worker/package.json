{
  "name": "@clubadmin/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs (Graphile Worker). Built in P0.3.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file ../api/.swcrc --ignore \"**/*.test.ts\" --ignore \"src/testing/**\"",
    "dev": "node ../../packages/devtools/src/watch-server.ts",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js ./dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@clubadmin/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "chokidar": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@clubadmin/country-packs": "workspace:*",
    "@clubadmin/db": "workspace:*",
    "@clubadmin/server-kit": "workspace:*",
    "@clubadmin/shared": "workspace:*",
    "graphile-worker": "catalog:",
    "zod": "catalog:"
  }
}
