{
  "name": "@clubadmin/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST API and WebSocket gateway (NestJS on Fastify). Built in P0.3.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc --ignore \"**/*.test.ts\" --ignore \"src/testing/**\"",
    "dev": "node ../../packages/devtools/src/watch-server.ts",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js ./dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi": "pnpm run build && node --enable-source-maps ./dist/scripts/write-openapi.js",
    "bench": "node --enable-source-maps ./dist/scripts/bench.js"
  },
  "devDependencies": {
    "@clubadmin/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "chokidar": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@clubadmin/i18n": "workspace:*",
    "@clubadmin/server-kit": "workspace:*",
    "@clubadmin/shared": "workspace:*",
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  }
}
