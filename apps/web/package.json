{
  "name": "@clubadmin/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js web app: backend-for-frontend login and session (P0.6) and the app shell (P0.9).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port ${WEB_PORT:-3000}",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start --port ${WEB_PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bundle:check": "node scripts/check-bundle.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@clubadmin/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@clubadmin/api-client": "workspace:*",
    "@clubadmin/i18n": "workspace:*",
    "@clubadmin/server-kit": "workspace:*",
    "@clubadmin/shared": "workspace:*",
    "@clubadmin/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "ioredis": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "openid-client": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
